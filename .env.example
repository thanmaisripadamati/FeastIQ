# FeastIQ server-side environment variables.
#
# Copy this file to `.env` in the project root and fill in the value.
# `.env` is git-ignored and must NEVER be committed.
#
# IMPORTANT: do NOT rename this to a VITE_* variable. Vite exposes every
# VITE_* variable to the browser bundle. FeastIQ keeps this key server-side
# only; on Vercel set it under Project Settings -> Environment Variables.

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
